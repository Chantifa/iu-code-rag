# Copy to .env and adjust.

# Optional: a GitHub token raises the API rate limit (60 -> 5000 requests/hour). Never commit it.
GITHUB_TOKEN=

# Generation backend: ollama (default in docker compose) | anthropic | none (extractive snippets only)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_BASE_URL=http://localhost:11434

# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Local embedding model (runs on CPU, downloaded once from Hugging Face)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval
TOP_K=6
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
